# Django settings (local development defaults).
# DEBUG defaults to false. Enable it only for local development by setting
# DJANGO_DEBUG=true (here or on the command line).
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: supply your own SECRET_KEY. If empty or unset, a strong key is
# generated on first run and persisted on the demo_data volume
# (/app/data/django_secret_key). Never commit a real key.
DJANGO_SECRET_KEY=

# Local host port for the demo (bound to 127.0.0.1 only). Defaults to 8000;
# start.sh / start.ps1 fall back to the next free port when it is busy.
HOST_PORT=8000

# Development-only demo passwords used by `python manage.py seed_demo`.
# Never reuse these values outside local development.
# Passwords are applied only when a demo account is first created.
DEMO_ADMIN_PASSWORD=demo-admin-pass
DEMO_TEACHER_PASSWORD=demo-teacher-pass
DEMO_STUDENT_PASSWORD=demo-student-pass
